<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recording needs precise fixes; coarse location cannot draw a track. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Android keeps delivering location with the screen off only to a
      foreground service, and from API 34 that service must declare its type
      and hold the matching permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- The ongoing notification is what keeps the service alive; from API 33
         posting it needs the user's consent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The off-route warning. A message on a screen that is in a pocket
         warns nobody; a buzz is the only part of it that arrives. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yolak">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Hands the composed share image to whichever app the athlete picks.
            Another app cannot read this one's cache directory, and a file://
            URI is refused outright since Android 7 — a content provider with a
            per-share grant is the only way an image reaches Instagram.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
